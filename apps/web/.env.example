# Supabase project (Settings → API). Either naming convention works — the app
# accepts the dashboard quickstart names and the legacy names.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable key (sb_publishable_…). Legacy alias: NEXT_PUBLIC_SUPABASE_ANON_KEY
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Secret key (sb_secret_…) — server-only, used by /api/invites and
# /api/u/[token]. Legacy alias: SUPABASE_SERVICE_ROLE_KEY. Never expose to the
# browser.
SUPABASE_SECRET_KEY=sb_secret_...

# Absolute origin used in invite / recovery email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
