# PostgreSQL connection — any plain Postgres 15+ (local, VPS, managed).
# Migrations (npm run db:migrate) need a privileged user; the app works with
# the same URL or a restricted user that can SET ROLE authenticated.
DATABASE_URL=postgresql://postgres:password@localhost:5432/solarflow
# Set to 'require' for managed databases that need TLS without a local CA.
#DATABASE_SSL=require

# Outbound email (invites, OTP codes, recovery links). Any SMTP provider —
# a Hostinger mailbox works. Without SMTP_HOST, development logs emails to
# the server console and production refuses to send.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="SolarFlow AI <no-reply@yourdomain.com>"

# Absolute origin used in emailed links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# E-signature through PandaDoc (contracts and change orders). The API key is
# PandaDoc → Settings → API & Integrations → API key. The webhook key is the
# shared key PandaDoc shows when you add a webhook pointed at
#   https://<your domain>/api/integrations/pandadoc/webhook?signature={signature}
# with the "Document state changed" event. Without the webhook, Check status
# on the record still finishes a signed document. Templates are chosen in
# Admin → Settings → E-signature.
PANDADOC_API_KEY=
PANDADOC_WEBHOOK_KEY=

# Ask SolarFlow — the assistant in the sidebar — and the AI automation
# (document reading, reply drafts, morning briefings; Admin → AI automation).
# An Anthropic API key from console.anthropic.com → API keys. Without it the
# panel says it is not connected, the automation queues nothing, and nothing
# else changes. Optional: ASSISTANT_MODEL (default claude-opus-5),
# ASSISTANT_EFFORT for the chat (low | medium | high | xhigh | max, default
# medium) and AI_EFFORT for the automation jobs (default low).
ANTHROPIC_API_KEY=

# The scheduled job (/api/push/reminders): reminders, notification delivery,
# the timed rules and the AI queue. vercel.json runs it every ten minutes with
# this secret as `Authorization: Bearer …`; any other scheduler can call it the
# same way. Without it only an admin's Run now button runs the job.
CRON_SECRET=
